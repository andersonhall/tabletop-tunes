# Copy to .env (gitignored) and fill in. Only the playlist-generation tools
# in tools/ read these; the web app never sees them.

# BoardGameGeek XML API token — https://boardgamegeek.com/using_the_xml_api
BGG_API_TOKEN=

# YouTube Data API v3 key (free) — see docs/generating-playlists.md
YOUTUBE_API_KEY=
