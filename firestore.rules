rules_version = '2';

// Per-user data lives under users/{uid}. Only that user can read it, and only
// allowlisted accounts can write it: an account is allowlisted by a
// writers/{uid} doc, created by hand in the Firebase console. To open saving
// to everyone who signs in, drop the isWriter() check. Data model and setup:
// docs/backend.md. Tests: firestore.rules.test.ts (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isWriter(uid) {
      return exists(/databases/$(database)/documents/writers/$(uid));
    }

    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isWriter(uid);
    }

    // Lets the app ask "can I save?" for the signed-in account only.
    match /writers/{uid} {
      allow get: if isOwner(uid);
    }
  }
}
